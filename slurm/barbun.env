# Settings for the barbun-cuda partition on the arf clusters. Source it rather
# than retyping the exports, which are lost with the shell and whose absence is
# quiet: the campaign would run against the default scratch directory, with no
# partition or account, and its rows would mix with an earlier cluster's.
#
#   source slurm/barbun.env && ./slurm/run_campaign.sh --dry-run
#
# The scratch path is deliberately per-cluster. The TRUBA clusters mount the
# same /arf, so a shared directory would let resume fill the gaps in one curve
# with points measured on different client hardware.
export LAYOUT_SCRATCH=/arf/scratch/$USER/layout-tuning-barbun
export LAYOUT_PARTITION=barbun-cuda
export LAYOUT_ACCOUNT=$USER
export LAYOUT_CORES=20          # barbun-cuda takes multiples of 20
export LAYOUT_CORES_WIDE=40
export LAYOUT_GRES_WIDE=gpu:2   # raise if the partition wants a different ratio
